# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (auto-injected or custom domain)
APP_URL="MY_APP_URL"

# WHATSAPP BUSINESS CLOUD API CONFIGURATION (Meta Developer Portal)
# WHATSAPP_PHONE_NUMBER_ID: ID nomor telepon WhatsApp Business di Meta for Developers
WHATSAPP_PHONE_NUMBER_ID=""

# WHATSAPP_ACCESS_TOKEN: Meta Permanent System User Token atau Graph API Access Token
WHATSAPP_ACCESS_TOKEN=""

# WHATSAPP_ADMIN_NUMBER: Nomor WhatsApp admin penerima notifikasi order (format internasional tanpa +, contoh: 6281234567890)
WHATSAPP_ADMIN_NUMBER=""

# WHATSAPP_API_VERSION: Versi Graph API Meta (default: v21.0)
WHATSAPP_API_VERSION="v21.0"

# WHATSAPP_TEMPLATE_NAME: Opsional jika menggunakan approved message template
WHATSAPP_TEMPLATE_NAME=""

# WHATSAPP_APP_SECRET: Meta App Secret dari App Dashboard > Settings > Basic (untuk verifikasi X-Hub-Signature-256)
WHATSAPP_APP_SECRET=""

# WHATSAPP_VERIFY_TOKEN: Token verifikasi callback webhook Meta di WhatsApp > Configuration
WHATSAPP_VERIFY_TOKEN="ipl_wa_verify_2026"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="ipl_wa_verify_2026"

# SUPABASE DATABASE CONFIGURATION (PostgreSQL Database)
# SUPABASE_URL: URL Project Supabase Anda (contoh: https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=""

# SUPABASE_KEY: Supabase Service Role Key (disarankan untuk backend) atau Anon Key
SUPABASE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ELEVENLABS WEBHOOK CONFIGURATION
# ELEVENLABS_WEBHOOK_SECRET: Bearer token rahasia untuk autentikasi endpoint /api/webhooks/elevenlabs/order
ELEVENLABS_WEBHOOK_SECRET="ipl_sec_elevenlabs_order_2026"

# ELEVENLABS CHAT AI AGENT CONFIGURATION (Untuk Agen AI Chat Dua Arah)
# ELEVENLABS_AGENT_ID: ID Agen Conversational AI dari dashboard ElevenLabs (opsional)
ELEVENLABS_AGENT_ID=""
# ELEVENLABS_API_KEY: API Key akun ElevenLabs Anda
ELEVENLABS_API_KEY=""

# ADMIN DASHBOARD AUTHENTICATION
# ADMIN_PASSWORD: Kata sandi login dashboard admin (default jika tidak diset: indoplangsir2026)
ADMIN_PASSWORD="indoplangsir2026"
