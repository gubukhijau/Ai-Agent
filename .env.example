# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (auto-injected or custom domain)
APP_URL="MY_APP_URL"

# WHATSAPP BUSINESS CLOUD API CONFIGURATION (Meta Developer Portal)
# WHATSAPP_PHONE_NUMBER_ID: ID nomor telepon WhatsApp Business di Meta for Developers
WHATSAPP_PHONE_NUMBER_ID=""

# WHATSAPP_ACCESS_TOKEN: Meta Permanent System User Token atau Graph API Access Token
WHATSAPP_ACCESS_TOKEN=""

# WHATSAPP_ADMIN_NUMBER: Nomor WhatsApp admin penerima notifikasi order (format internasional tanpa +, contoh: 6281234567890)
WHATSAPP_ADMIN_NUMBER=""

# WHATSAPP_API_VERSION: Versi Graph API Meta (default: v21.0)
WHATSAPP_API_VERSION="v21.0"

# WHATSAPP_TEMPLATE_NAME: Opsional jika menggunakan approved message template
WHATSAPP_TEMPLATE_NAME=""

# ELEVENLABS WEBHOOK CONFIGURATION
# ELEVENLABS_WEBHOOK_SECRET: Bearer token rahasia untuk autentikasi endpoint /api/webhooks/elevenlabs/order
ELEVENLABS_WEBHOOK_SECRET="ipl_sec_elevenlabs_order_2026"

# ADMIN DASHBOARD AUTHENTICATION
# ADMIN_PASSWORD: Kata sandi login dashboard admin (default jika tidak diset: indoplangsir2026)
ADMIN_PASSWORD="indoplangsir2026"

